class Kmeans_SIMD
	float[] buffer, x_pack, centroids
	int[] labels
	int M, N, M_padded, K

	ctor(float[] buffer, array<int> dims, int K)
		self.buffer = buffer
		self.M = dims[0]
		self.N = dims[1]
		self.K = K
		
		int rem = self.M % 16
		if rem == 0
			self.M_padded = self.M
		else
			self.M_padded = self.M + (16 - rem)
			
		self.x_pack = c_malloc(self.M_padded * self.N * 4)
		self.centroids = c_malloc(self.K * self.N * 4)
		self.labels = c_malloc(self.M * 4)


	def float evaluate_accuracy(int[] true_labels)
		int[] cluster_to_label = c_malloc(self.K * 4)
		
		# 1. Map each cluster ID to the majority true label
		for c_i=0, c_i<self.K
			# Assuming true labels are integers 0 to K-1 cast as floats
			int[] label_counts = c_malloc(self.K * 4)
			for l=0, l<self.K
				label_counts[l] = 0
				
			# Count true labels for points assigned to this cluster (c_i)
			for i=0, i<self.M
				if self.labels[i] == c_i
					int t_label = true_labels[i]
					label_counts[t_label] += 1
					
			# Find the most frequent true label (majority vote)
			int best_label = 0
			int max_count = -1
			for l=0, l<self.K
				if label_counts[l] > max_count
					max_count = label_counts[l]
					best_label = l
					
			cluster_to_label[c_i] = best_label
			c_free(label_counts)
			
		# 2. Calculate overall accuracy using the mapped labels
		int correct = 0
		for i=0, i<self.M
			int pred_cluster = self.labels[i]
			int mapped_label = cluster_to_label[pred_cluster]
			
			if mapped_label == true_labels[i]
				correct += 1
				
		float accuracy = correct / self.M
		
		print("Correctly clustered: ", correct, " / ", self.M)
		print("Accuracy: ", accuracy * 100.0, "%")
		
		c_free(cluster_to_label)
		return accuracy


		
	def void pad_buffer()
		for i=0, i<self.M_padded * self.N, 1
			self.x_pack[i] = 0.0

		[0..self.M,0..self.N] i, j
			self.x_pack[j * self.M_padded + i] = self.buffer[i * self.N + j]


	def void simd_kmeans_dist_1x16(float[] dist_matrix, int c_i, int m_offset)
		vec<float,16> acc = vec_make(0.0, 16)

		for f=0, f<self.N, 1
			vec<float,16> x_f = simd_load(self.x_pack offby f * self.M_padded + m_offset, float, 16)
			vec<float,16> c_f = vec_make(self.centroids[c_i * self.N + f], 16)

			vec<float,16> diff = x_f - c_f
			acc += diff * diff

		simd_store(dist_matrix offby c_i * self.M_padded + m_offset, acc)


	def int kmeans_worker()
		float[] dist_matrix = c_malloc(self.K * self.M_padded * 4)
		int changes = 0

		# E-Step: SIMD distance calculation
		for m_offset=0, m_offset<self.M_padded, 16
			for c_i=0, c_i<self.K, 1
				self.simd_kmeans_dist_1x16(dist_matrix, c_i, m_offset)

		# E-Step: Label Assignment (Argmin)
		for i=0, i<self.M, 1
			float min_dist = dist_matrix[0 * self.M_padded + i]
			int best_label = 0
			
			for c_i=1, c_i<self.K, 1
				float d = dist_matrix[c_i * self.M_padded + i]
				if d < min_dist
					min_dist = d
					best_label = c_i
					
			if self.labels[i] != best_label
				self.labels[i] = best_label
				changes += 1

		c_free(dist_matrix)
		return changes


	def void update_centroids()
		int[] counts = c_malloc(self.K * 4)
		float[] new_sums = c_malloc(self.K * self.N * 4)

		for c_i=0, c_i<self.K, 1
			counts[c_i] = 0
			for f=0, f<self.N, 1
				new_sums[c_i * self.N + f] = 0.0

		for i=0, i<self.M, 1
			int c_i = self.labels[i]
			counts[c_i] += 1
			for f=0, f<self.N, 1
				new_sums[c_i * self.N + f] += self.buffer[i * self.N + f]

		for c_i=0, c_i<self.K, 1
			if counts[c_i] > 0
				for f=0, f<self.N, 1
					self.centroids[c_i * self.N + f] = new_sums[c_i * self.N + f] / counts[c_i]

		c_free(counts)
		c_free(new_sums)

	def void init_centroids()
		# inits centroids as random instances

		int[] chosen = c_malloc(self.K * 4)
		
		for c_i=0, c_i<self.K
			bool unique = false
			int random_idx = 0
			
			while not unique
				unique = true
				random_idx = randint(0, self.M - 1)
				
				for prev=0, prev<c_i
					if chosen[prev] == random_idx
						unique = false
						break
			
			chosen[c_i] = random_idx
			
			for f=0, f<self.N, 1
				self.centroids[c_i * self.N + f] = self.buffer[random_idx * self.N + f]
				
		c_free(chosen)


	def void print_centroids()
		[0..self.K] k
			[0..self.N] n
				print(self.centroids[k*self.N + n])
			print("")
	def void print_labels()
		[0..self.M] m
			print(self.labels[m])

	def void train(int max_iters)
		self.pad_buffer()
		self.init_centroids()
		#self.print_centroids()

		for i=0, i<self.M, 1
			self.labels[i] = -1



		int iter = 0
		while iter < max_iters
			iter += 1
			int changes = self.kmeans_worker()
			
			if changes == 0
				break
				
			self.update_centroids()

		print("K-Means converged in ", iter, " iterations.")
